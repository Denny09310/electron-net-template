{
    "$schema": "http://json.schemastore.org/template",
    "author": "Denny093",
    "classifications": [
        "Desktop",
        "Electron",
        "Web",
        "ASP.NET",
        "Cross Platform"
    ],
    "identity": "Electron.NET.Template",
    "groupIdentity": "Electron.NET.Template",
    "name": "Electron.NET Desktop Application",
    "shortName": "electron-net",
    "description": "Creates an Electron.NET desktop application with ASP.NET Core backend integration.",
    "sourceName": "Client",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "icon": "icon.png",
    "symbols": {
        "Framework": {
            "type": "parameter",
            "datatype": "choice",
            "description": "Target framework",
            "choices": [
                {
                    "choice": "net9.0",
                    "description": ".NET 9"
                },
                {
                    "choice": "net10.0",
                    "description": ".NET 10"
                }
            ],
            "defaultValue": "net10.0",
            "replaces": "net10.0"
        },
        "assemblyNameSnakeCase": {
            "type": "derived",
            "valueSource": "name",
            "valueTransform": "AssemblyNameSnakeCase",
            "replaces": "{name_of_the_assembly_snake_case}",
            "description": "Snake case version of the scaffolded project name"
        }
    },
    "forms": {
        "AssemblyNameSnakeCase": {
            "identifier": "chain",
            "steps": [
                "SplitAcronyms",
                "SplitWords",
                "NormalizeSeparators",
                "Lowercase"
            ]
        },
        "SplitAcronyms": {
            "identifier": "replace",
            "pattern": "([A-Z]+)([A-Z][a-z])",
            "replacement": "$1_$2"
        },
        "SplitWords": {
            "identifier": "replace",
            "pattern": "([a-z0-9])([A-Z])",
            "replacement": "$1_$2"
        },
        "NormalizeSeparators": {
            "identifier": "replace",
            "pattern": "[^A-Za-z0-9]+",
            "replacement": "_"
        },
        "Lowercase": {
            "identifier": "lowerCaseInvariant"
        }
    },
    "sources": [
        {
            "source": "./Client",
            "target": "./",
            "modifiers": [
                {
                    "exclude": [
                        "**/[Bb]in/**",
                        "**/[Oo]bj/**",
                        ".template.config/**/*",
                        ".vs/**/*",
                        ".idea/**/*",
                        ".vscode/**/*"
                    ]
                }
            ]
        }
    ],
    "primaryOutputs": [
        {
            "path": "Client.csproj"
        }
    ],
    "postActions": [
        {
            "condition": "(!skipRestore)",
            "description": "Restore NuGet packages required by this project.",
            "manualInstructions": [
                {
                    "text": "Run 'dotnet restore'"
                }
            ],
            "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
            "continueOnError": true
        }
    ]
}