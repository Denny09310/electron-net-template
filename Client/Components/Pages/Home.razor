@page "/"

@inject Shell Shell

<div class="flex-1 flex flex-col items-center justify-center px-6 text-center">

    <!-- Header -->
    <div class="max-w-xl">

        <!-- Icons -->
        <div class="flex justify-center items-center gap-12 mb-6">
            <img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/electron/electron-original.svg"
                 class="h-16 w-16 transition duration-300 hover:drop-shadow-[0_0_12px_rgba(59,130,246,0.8)]"
                 alt="Electron" />

            <img src="https://raw.githubusercontent.com/devicons/devicon/master/icons/blazor/blazor-original.svg"
                 class="h-16 w-16 transition duration-300 hover:drop-shadow-[0_0_12px_rgba(168,85,247,0.8)]"
                 alt="Blazor" />
        </div>

        <h1 class="text-4xl font-bold tracking-tight mb-4">
            Electron .NET + Blazor
        </h1>

        <p class="text-gray-400 text-lg">
            Build fast cross-platform desktop apps using Electron and Blazor.
        </p>
    </div>

    <!-- Actions -->
    <div class="mt-10 flex flex-wrap gap-4 justify-center">

        <BbButton Variant="ButtonVariant.Outline"
                  @onclick="@(() => OpenExternalAsync("https://github.com/ElectronNET/Electron.NET/wiki"))">
            Electron.NET
        </BbButton>

        <BbButton Variant="ButtonVariant.Outline"
                  @onclick="@(() => OpenExternalAsync("https://blazorblueprintui.com/"))">
            Blazor Blueprint
        </BbButton>

        <BbButton Variant="ButtonVariant.Outline">
            Template Repo
        </BbButton>

    </div>

    <!-- Footer / Info -->
    <div class="mt-12 text-sm text-gray-500">
        <p>.NET @Environment.Version • Electron.NET 0.5.2 • BlazorBlueprint 3.15.0</p>
    </div>

</div>

@code
{
    private async Task OpenExternalAsync(string url)
    {
        await Shell.OpenExternalAsync(url);
    }
}