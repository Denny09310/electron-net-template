<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="BlazorCommon">
    <CompressionEnabled>false</CompressionEnabled>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <PropertyGroup Label="ElectronNetCommon">
    <ElectronVersion>44.2.0</ElectronVersion>
    <ElectronBuilderVersion>26.15.3</ElectronBuilderVersion>
    <ElectronIcon>Assets\appicon.ico</ElectronIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Components" Version="3.15.0" />
    <PackageReference Include="ElectronNET.Core" Version="0.5.2" />
    <PackageReference Include="ElectronNET.Core.AspNet" Version="0.5.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custom Electron Main -->
    <None Update="Electron\custom_main.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>.electron\custom_main.js</TargetPath>
    </None>
    
    <!-- Assets Folder  -->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
