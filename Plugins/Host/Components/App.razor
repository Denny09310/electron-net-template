@inject PluginRegistry Registry

<!DOCTYPE html>
<html lang="en" class="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/BlazorBlueprint.Components/blazorblueprint.css"]" />
    <link rel="stylesheet" href="@Assets["css/tailwind.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["HostApp.styles.css"]" />
    <!-- Each loaded plugin's tailwind.min.css (when present) -->
    <PluginStylesheets />
    <ImportMap />
    <HeadOutlet @rendermode="Rendering" />
    <script src="@Assets["_content/BlazorBlueprint.Components/js/theme-init.js"]"></script>
    <script src="@Assets["lib/theme-init.js"]"></script>
</head>

<body>
    <Routes @rendermode="Rendering" />
    <ReconnectModal />
    <script src="@Assets["_content/Bit.Butil/bit-butil.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code
{
    private static readonly InteractiveServerRenderMode Rendering = new(false);
}
