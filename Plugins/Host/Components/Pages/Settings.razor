@page "/settings"

@using Plugins.Abstractions

@inject Bit.Butil.History History
@inject NavigationManager Nav
@inject IEnumerable<ISettingsContributor> Contributors
@inject ILocalizationService Localization
@inject IStringLocalizer<Resources.Localization.Strings> Loc

<div class="space-y-4 p-4">
    <header class="inline-flex items-center gap-2">
        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" @onclick="History.GoBack">
            <LucideIcon Name="chevron-left" Size="24" />
        </BbButton>
        <h1 class="text-2xl font-semibold leading-6">@Loc["Settings_Header_Title"]</h1>
    </header>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle>@Loc["Language_Card_Title"]</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <div class="flex max-w-xs flex-col gap-2">
                <BbLabel>@Loc["Language_Field_Label"]</BbLabel>
                <BbSelect TValue="string" @bind-Value="_selectedCulture" @bind-Value:after="OnLanguageChanged"
                          Options="_languageOptions" />
            </div>
        </BbCardContent>
    </BbCard>

    @foreach (var setting in Contributors)
    {
        <BbCard @key="setting.Id">
            <BbCardHeader>
                <BbCardTitle>@setting.Title</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <DynamicComponent Type="@setting.ComponentType" />
            </BbCardContent>
        </BbCard>
    }
</div>

@code
{
    private List<SelectOption<string>> _languageOptions = [];
    private string? _selectedCulture;

    protected override async Task OnInitializedAsync()
    {
        _languageOptions = [.. Localization.SupportedCultures
            .Select(culture => new SelectOption<string>(culture.Name, culture.NativeName))];

        _selectedCulture = await Localization.GetPreferredCultureAsync()
            ?? Localization.SupportedCultures[0].Name;
    }

    private async Task OnLanguageChanged()
    {
        if (string.IsNullOrWhiteSpace(_selectedCulture))
            return;

        await Localization.SetPreferredCultureAsync(_selectedCulture);

        Nav.Refresh(forceReload: true);
    }
}
